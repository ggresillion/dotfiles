input {
    keyboard {
        xkb {
          layout "us"
          variant "intl"
        }
        repeat-delay 200
        repeat-rate 20
        numlock
    }

    // macOS-like: acceleration (flat suits mice, not touchpads), content
    // follows the fingers, two-finger right click, and the touchpad ignores
    // touches while typing or while the trackpoint is in use.
    touchpad {
        accel-profile "adaptive"
        accel-speed 0.2
        natural-scroll
        scroll-method "two-finger"
        scroll-factor 0.3
        click-method "clickfinger"
        dwt
        dwtp
    }

    mouse {
        accel-speed 0
        accel-profile "flat"
    }

    trackpoint {
        accel-speed 0
        accel-profile "flat"
    }

    warp-mouse-to-focus
}
